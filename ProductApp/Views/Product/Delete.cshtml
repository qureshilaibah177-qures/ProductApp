@model ProductApp.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}
<div class="container mt-4" style="max-width: 600px;">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Are you sure you want to delete this product?</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Product ID</dt>
                <dd class="col-sm-8">@Model.ProductId</dd>

                <dt class="col-sm-4">Barcode</dt>
                <dd class="col-sm-8">@Model.Barcode</dd>

                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Category</dt>
                <dd class="col-sm-8">@Model.Category</dd>

                <dt class="col-sm-4">Price</dt>
                <dd class="col-sm-8">$@Model.Price</dd>

                <dt class="col-sm-4">Stock</dt>
                <dd class="col-sm-8">@Model.StockQuantity</dd>
            </dl>
            <form asp-action="Delete" method="post" class="mt-4">
                <input type="hidden" asp-for="ProductId" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>